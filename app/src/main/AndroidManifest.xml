<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 悬浮层回落 TYPE_APPLICATION_OVERLAY 时需要；正常路径走免权限的 TYPE_ACCESSIBILITY_OVERLAY -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 热更新：仅「检查更新」时联网 + 下载 APK 后调起系统安装器 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 后台更新就绪通知（Android 13+ 运行时授权，仅询问一次） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".LightCopyApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LightCopy">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 无障碍服务：进程常驻，悬浮层宿主。BIND_ACCESSIBILITY_SERVICE 为签名级权限，仅系统可绑定。
             声明严格对齐 AutoJS6（SuperMonster003/AutoJs6）已验证可绑定的写法：
             - intent-filter 内只放 <action>，**不要加 <category CATEGORY_DEFAULT>**；
             - 不加 android:label（系统自行取 application label）。
             多声明 category 会让部分 ROM/PM 的 intent 解析把该服务排除在无障碍服务枚举之外，
             表现为"设置里能看到、但系统永远 bind 不上"（卡在 Binding services）。 -->
        <service
            android:name=".CopyAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_info" />
        </service>

        <!-- 快捷设置瓦片「复制模式」：不 startService，直接静态调无障碍单例。
             注意 action 是官方常量 ACTION_QS_TILE（android.service.quicksettings.action.QS_TILE），
             写成类名会导致瓦片永远不进系统瓦片池（queryIntentServices 匹配不到） -->
        <service
            android:name=".CopyModeTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>